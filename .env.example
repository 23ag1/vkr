# ============================================================
# VKR — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vkr
POSTGRES_USER=vkr
POSTGRES_PASSWORD=changeme_strong_password

# --- Backend ---
SECRET_KEY=changeme_at_least_32_chars_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Demo users (python -m app.seed) ---
# Leave empty to get random passwords printed once by the seed script.
SEED_ADMIN_PASSWORD=
SEED_SPECIALIST_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
ENVIRONMENT=development    # development | production
LOG_LEVEL=INFO

# --- Frontend dev proxy ---
# Vite /api proxy target. Defaults to http://localhost:8000 for local `npm run dev`.
# docker-compose overrides it to the backend container hostname.
# VITE_PROXY_TARGET=http://localhost:8000
